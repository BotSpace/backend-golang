# All settings can be overridden via APP_* env vars (nested keys use "_").
# Example: APP_DB_HOST=db, APP_JWT_SECRET=...

APP_ENV=development

APP_HTTP_HOST=0.0.0.0
APP_HTTP_PORT=8080
APP_HTTP_MAX_BODY_BYTES=1048576
# Comma-separated origins, or "*". e.g. https://app.example.com
APP_HTTP_CORS_ORIGINS=*
# Per-IP rate limit (req/sec); 0 disables. Burst defaults to 20.
APP_HTTP_RATE_LIMIT_RPS=0

APP_DB_HOST=localhost
APP_DB_PORT=5432
APP_DB_USER=postgres
APP_DB_PASSWORD=postgres
APP_DB_NAME=botspace
APP_DB_SSL_MODE=disable
# Run pending migrations on startup. Disable in prod and use `make migrate-up`.
APP_DB_AUTO_MIGRATE=true

# RS256 keys. Dev'da yo'q bo'lsa avtomatik generatsiya bo'ladi.
# PRODUCTION: kalitni bir marta yarating (make gen-keys), secret manager'da saqlab
# barcha deploylarda qayta ishlating. Dev kalitlarni prodda ishlatmang.
APP_JWT_PRIVATE_KEY_PATH=keys/jwt_private.pem
APP_JWT_PUBLIC_KEY_PATH=keys/jwt_public.pem
APP_OTP_PROD=false
APP_OTP_DEFAULT=1111

APP_JWT_ACCESS_TTL=15m
APP_JWT_REFRESH_TTL=168h

# Secrets-at-rest key (credential data, bot tokens) — AES-256-GCM. Set a long
# random string in production and NEVER change it (would orphan encrypted rows).
APP_CRYPTO_KEY=change-me-in-production
# Shared secret for internal engine<->backend endpoints (X-Internal-Token).
APP_INTERNAL_TOKEN=change-me-internal
# Local media dir for uploaded files / KYC docs.
APP_MEDIA_DIR=./media
# MongoDB (CMS documents, per-project databases).
APP_MONGO_URL=mongodb://localhost:27017

# Payment gateways
APP_CLICK_SERVICE_ID=
APP_CLICK_MERCHANT_ID=
APP_CLICK_SECRET_KEY=
APP_PAYME_ID=
APP_PAYME_KEY=

APP_LOG_LEVEL=debug

# Google sign-in (POST /api/v1/auth/google) — ID token audience.
APP_GOOGLE_CLIENT_ID=
# Google OAuth2 offline-access app (POST /api/v1/credentials/oauth/google/start/)
# — google_email/google_sheets/google_drive credential types. Usually the same
# OAuth client as APP_GOOGLE_CLIENT_ID above.
APP_GOOGLE_OAUTH_CLIENT_ID=
APP_GOOGLE_OAUTH_CLIENT_SECRET=

# Django's settings.SECRET_KEY — needed for two things that must stay
# byte-for-byte compatible with the still-live Django deployment:
#   1. cmd/reencrypt-credentials: credential.data_encrypted rows imported by
#      the ETL are still Fernet-encrypted with this key (sha256-derived).
#   2. POST /api/v1/credentials/oauth/{provider}/start/: the state token is
#      signed the same way django.core.signing.TimestampSigner does, since
#      Django's (unported) OAuthCallbackView verifies it.
DJANGO_SECRET_KEY=
